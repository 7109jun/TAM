fn div(a: i32, b: i32) Result<i32, i32> {
    if b == 0 { return Err(1) }
    Ok(a / b)
}

fn calc(a: i32, b: i32, c: i32) Result<i32, i32> {
    let x = div(a, b)?
    let y = div(x, c)?
    Ok(x + y)
}

fn main() i32 {
    match calc(100, 5, 4) {
        Ok(v) => v
        Err(e) => 0 - e
    }
}
