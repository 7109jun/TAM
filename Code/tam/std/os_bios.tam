// tam.os (BIOS) — 직렬 포트(COM1)가 표준 출력이다. 공개 API는 print/println/print_int/exit.
use tam.fmt
use tam.serial

pub fn print(s: str) { serial::print(s) }

pub fn println(s: str) {
    serial::print(s)
    serial::print("\n")
}

pub fn print_int(n: i64) { serial::print_int(n) }

// QEMU의 isa-debug-exit 장치(0xF4)에 코드를 쓰고 멈춘다. 실제 하드웨어에서는 그냥 멈춘다.
pub fn exit(code: i32) {
    unsafe {
        port_out8(244, code as u8)
        while true { halt() }
    }
}
