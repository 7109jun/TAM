// tam.os (Windows) — kernel32 위의 OS 계층. 공개 API는 os_linux.tam과 같다.
use tam.fmt

extern "kernel32" fn GetStdHandle(id: u32) *mut u8
extern "kernel32" fn WriteFile(h: *mut u8, buf: *const u8, n: u32, written: *mut u32, ov: *mut u8) i32
extern "kernel32" fn ReadFile(h: *mut u8, buf: *mut u8, n: u32, got: *mut u32, ov: *mut u8) i32
extern "kernel32" fn CreateFileA(path: *const u8, access: u32, share: u32, sec: *mut u8, disp: u32, flags: u32, tmpl: *mut u8) *mut u8
extern "kernel32" fn CloseHandle(h: *mut u8) i32
extern "kernel32" fn GetLastError() u32
extern "kernel32" fn GetTickCount64() u64
extern "kernel32" fn ExitProcess(code: u32)

// 표준 출력에 쓴다.
pub fn print(s: str) {
    mut written: u32 = 0
    unsafe {
        let r = WriteFile(GetStdHandle(4294967285), s.ptr, s.len as u32, &mut written as *mut u32, 0 as *mut u8)
    }
}

pub fn println(s: str) {
    print(s)
    print("\n")
}

pub fn print_int(n: i64) {
    let t = fmt::int_to_string(n)
    print(as_str(&t))
}

// 프로세스를 바로 끝낸다.
pub fn exit(code: i32) {
    unsafe { ExitProcess(code as u32) }
}

// 표준 입력에서 한 줄을 읽는다(줄바꿈 제외). 입력이 끝나면 지금까지 읽은 것을 돌려준다.
pub fn read_line() String {
    mut line = string_from("")
    mut ch: u8 = 0
    mut got: u32 = 0
    let h = unsafe { GetStdHandle(4294967286) }
    mut going = true
    while going {
        got = 0
        let r = unsafe { ReadFile(h, &mut ch as *mut u8, 1, &mut got as *mut u32, 0 as *mut u8) }
        if r == 0 || got == 0 {
            going = false
        } else if ch == 10 {
            going = false
        } else if ch != 13 {
            string_push(&mut line, ch)
        }
    }
    line
}

// 파일 전체를 읽는다. 실패하면 OS 오류 코드.
pub fn read_file(path: str) Result<String, i32> {
    let p = fmt::concat(path, "\0")
    let h = unsafe { CreateFileA(as_str(&p).ptr, 2147483648, 1, 0 as *mut u8, 3, 128, 0 as *mut u8) }
    if h == wrapping_sub(0, 1) as *mut u8 {
        return Err(unsafe { GetLastError() } as i32)
    }
    mut out = string_from("")
    let buf = unsafe { alloc(4096) }
    mut n: u32 = 1
    while n > 0 {
        n = 0
        let r = unsafe { ReadFile(h, buf, 4096, &mut n as *mut u32, 0 as *mut u8) }
        if r != 0 {
            mut i: u32 = 0
            while i < n {
                string_push(&mut out, unsafe { *(buf + i) })
                i = i + 1
            }
        } else {
            n = 0
        }
    }
    unsafe { free(buf) }
    unsafe { CloseHandle(h) }
    Ok(out)
}

// 파일을 만들어(이미 있으면 덮어써서) `data`를 쓴다. 쓴 바이트 수 또는 오류 코드.
pub fn write_file(path: str, data: str) Result<i32, i32> {
    let p = fmt::concat(path, "\0")
    let h = unsafe { CreateFileA(as_str(&p).ptr, 1073741824, 0, 0 as *mut u8, 2, 128, 0 as *mut u8) }
    if h == wrapping_sub(0, 1) as *mut u8 {
        return Err(unsafe { GetLastError() } as i32)
    }
    mut written: u32 = 0
    let r = unsafe { WriteFile(h, data.ptr, data.len as u32, &mut written as *mut u32, 0 as *mut u8) }
    unsafe { CloseHandle(h) }
    if r == 0 {
        return Err(unsafe { GetLastError() } as i32)
    }
    Ok(written as i32)
}

// 부팅 후 경과 시간(밀리초).
pub fn time_ms() u64 {
    unsafe { GetTickCount64() }
}
