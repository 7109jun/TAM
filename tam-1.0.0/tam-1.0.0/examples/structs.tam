struct Point {
    x: i32,
    y: i32
}

struct Rect {
    min: Point
    max: Point
}

fn area(r: &Rect) i32 {
    (r.max.x - r.min.x) * (r.max.y - r.min.y)
}

fn shift(p: &mut Point, dx: i32) {
    p.x = p.x + dx
    p.y = p.y + dx
}

fn swap(a: &mut i32, b: &mut i32) {
    let t = *a
    *a = *b
    *b = t
}

fn make(x: i32, y: i32) Point { Point { x: x, y: y } }

fn main() i32 {
    mut r = Rect { min: make(1, 2), max: Point { x: 5, y: 8 } }
    shift(&mut r.min, 1)
    mut a = 10
    mut b = 3
    swap(&mut a, &mut b)
    area(&r) * 10 + a - b
}
