// tam.fmt — 문자열 만들기. 플랫폼과 무관한 순수 TAM 코드다.

// `s` 뒤에 `t`의 바이트를 이어 붙인다.
pub fn push_str(s: &mut String, t: str) {
    mut i: u64 = 0
    while i < t.len {
        string_push(s, unsafe { *(t.ptr + i) })
        i = i + 1
    }
}

// `a` 다음에 `b`가 오는 새 문자열.
pub fn concat(a: str, b: str) String {
    mut s = string_from(a)
    push_str(&mut s, b)
    s
}

// 10진수 문자열. i64의 최솟값도 올바르게 처리한다.
pub fn int_to_string(n: i64) String {
    mut out = string_from("")
    mut v: u64 = n as u64
    if n < 0 {
        string_push(&mut out, 45)
        v = wrapping_sub(0, n) as u64
    }
    if v == 0 {
        string_push(&mut out, 48)
        return out
    }
    mut digits = string_from("")
    while v > 0 {
        string_push(&mut digits, (v % 10) as u8 + 48)
        v = v / 10
    }
    mut i = digits.len
    while i > 0 {
        i = i - 1
        string_push(&mut out, unsafe { *(digits.ptr + i) })
    }
    out
}
