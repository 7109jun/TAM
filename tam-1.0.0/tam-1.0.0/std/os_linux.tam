// tam.os (Linux) — libc 위의 OS 계층. 공개 API는 os_windows.tam과 같다.
use tam.fmt

extern "c" fn c_write(fd: i32, buf: *const u8, n: u64) i64 = "write"
extern "c" fn c_read(fd: i32, buf: *mut u8, n: u64) i64 = "read"
extern "c" fn c_open(path: *const u8, flags: i32, mode: i32) i32 = "open"
extern "c" fn c_close(fd: i32) i32 = "close"
extern "c" fn c_exit(code: i32) = "exit"
extern "c" fn c_clock_gettime(clock: i32, ts: *mut i64) i32 = "clock_gettime"
extern "c" fn c_errno() *mut i32 = "__errno_location"

struct Ts { sec: i64, nsec: i64 }

// 표준 출력에 쓴다.
pub fn print(s: str) {
    unsafe {
        let r = c_write(1, s.ptr, s.len)
    }
}

pub fn println(s: str) {
    print(s)
    print("\n")
}

pub fn print_int(n: i64) {
    let t = fmt::int_to_string(n)
    print(as_str(&t))
}

// 프로세스를 바로 끝낸다.
pub fn exit(code: i32) {
    unsafe { c_exit(code) }
}

// 표준 입력에서 한 줄을 읽는다(줄바꿈 제외). 입력이 끝나면 지금까지 읽은 것을 돌려준다.
pub fn read_line() String {
    mut line = string_from("")
    mut ch: u8 = 0
    mut going = true
    while going {
        let n = unsafe { c_read(0, &mut ch as *mut u8, 1) }
        if n <= 0 {
            going = false
        } else if ch == 10 {
            going = false
        } else if ch != 13 {
            string_push(&mut line, ch)
        }
    }
    line
}

// 파일 전체를 읽는다. 실패하면 errno.
pub fn read_file(path: str) Result<String, i32> {
    let p = fmt::concat(path, "\0")
    let fd = unsafe { c_open(as_str(&p).ptr, 0, 0) }
    if fd < 0 {
        return Err(unsafe { *c_errno() })
    }
    mut out = string_from("")
    let buf = unsafe { alloc(4096) }
    mut n: i64 = 1
    while n > 0 {
        n = unsafe { c_read(fd, buf, 4096) }
        if n > 0 {
            mut i: i64 = 0
            while i < n {
                string_push(&mut out, unsafe { *(buf + i) })
                i = i + 1
            }
        }
    }
    unsafe { free(buf) }
    unsafe { c_close(fd) }
    if n < 0 {
        return Err(unsafe { *c_errno() })
    }
    Ok(out)
}

// 파일을 만들어(이미 있으면 덮어써서) `data`를 쓴다. 쓴 바이트 수 또는 errno.
pub fn write_file(path: str, data: str) Result<i32, i32> {
    let p = fmt::concat(path, "\0")
    // O_WRONLY | O_CREAT | O_TRUNC, 모드 0644
    let fd = unsafe { c_open(as_str(&p).ptr, 577, 420) }
    if fd < 0 {
        return Err(unsafe { *c_errno() })
    }
    mut off: u64 = 0
    mut failed = false
    while off < data.len && !failed {
        let w = unsafe { c_write(fd, data.ptr + off, data.len - off) }
        if w <= 0 {
            failed = true
        } else {
            off = off + w as u64
        }
    }
    unsafe { c_close(fd) }
    if failed {
        return Err(unsafe { *c_errno() })
    }
    Ok(off as i32)
}

// 단조 시계(밀리초).
pub fn time_ms() u64 {
    mut ts = Ts { sec: 0, nsec: 0 }
    unsafe {
        let r = c_clock_gettime(1, &mut ts as *mut Ts as *mut i64)
    }
    (ts.sec * 1000 + ts.nsec / 1000000) as u64
}
